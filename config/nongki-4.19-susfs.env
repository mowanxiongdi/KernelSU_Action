# Redmi 6 Pro (sakura) - KernelSU-Next
KERNEL_SOURCE=https://github.com/Redmi6pro-development/android_kernel_xiaomi_sakura.git
KERNEL_SOURCE_BRANCH=master
KERNEL_CONFIG=sakura-perf_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

KSU_VARIANT=kernelsu-next
KSU_REF=legacy
KSU_HOOK_MODE=manual

ENABLE_SUSFS=false
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true
ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
